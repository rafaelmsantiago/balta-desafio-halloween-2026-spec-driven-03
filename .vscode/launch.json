{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Encurtador.Api (Scalar)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Encurtador.Api/bin/Debug/net10.0/Encurtador.Api.dll",
      "cwd": "${workspaceFolder}/src/Encurtador.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5289"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      },
      "console": "integratedTerminal"
    }
  ]
}
